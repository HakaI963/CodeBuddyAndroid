<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_chip" />

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_hint" />

    <LinearLayout
        android:id="@+id/sheetRowChat"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chat"
            android:tint="@color/text_secondary" />

        <TextView
            style="@style/SheetRowLabel"
            android:text="@string/home_continue" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetRowNew"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_add"
            android:tint="@color/text_secondary" />

        <TextView
            style="@style/SheetRowLabel"
            android:text="@string/home_new_chat" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetRowSidebar"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_panel"
            android:tint="@color/text_secondary" />

        <TextView
            style="@style/SheetRowLabel"
            android:text="@string/action_sidebar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetRowBrowser"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_open_in_new"
            android:tint="@color/text_secondary" />

        <TextView
            style="@style/SheetRowLabel"
            android:text="@string/home_open_browser" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetRowHome"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_home"
            android:tint="@color/text_secondary" />

        <TextView
            style="@style/SheetRowLabel"
            android:text="@string/action_home" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sheetRowSettings"
        style="@style/SheetRow">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_secondary" />

        <TextView
            style="@style/SheetRowLabel"
            android:text="@string/action_settings" />
    </LinearLayout>
</LinearLayout>
