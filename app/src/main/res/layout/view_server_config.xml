<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <com.flux.codebuddy.ui.MaxWidthLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            app:maxWidthDp="@dimen/config_max_width">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_logo"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_terminal"
                    android:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/configTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/setup_title"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:id="@+id/configSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/setup_subtitle"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_hint" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCloseSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_close"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close"
                    android:tint="@color/text_secondary"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/divider" />

            <!-- Server URL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/server_url_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="@string/server_url_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_tertiary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/urlError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/error"
                android:textSize="@dimen/text_hint"
                android:visibility="gone"
                tools:ignore="SmallSp"
                tools:text="Enter a valid http:// or https:// URL." />

            <!-- Display name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/display_name_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/field_height"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:hint="@string/display_name_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="40"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_tertiary"
                android:textSize="@dimen/text_body" />

            <CheckBox
                android:id="@+id/rememberCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="@color/accent"
                android:checked="true"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/remember_server"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <!-- UI size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_scale_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label" />

                <TextView
                    android:id="@+id/scaleValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_label"
                    tools:text="0.60× · 1.7× smaller" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/scaleSeek"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:max="6"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="2"
                android:progressBackgroundTint="@color/border"
                android:progressTint="@color/accent"
                android:splitTrack="false"
                android:thumbTint="@color/accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="1dp"
                android:text="@string/ui_scale_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_hint"
                tools:ignore="SmallSp" />

            <!-- Extras -->
            <CheckBox
                android:id="@+id/keepAwakeCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/accent"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/keep_awake"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <!-- Hints -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_flat"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:text="@string/setup_lan_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_hint"
                tools:ignore="SmallSp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/setup_security_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_hint"
                tools:ignore="SmallSp" />

            <TextView
                android:id="@+id/configStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/setup_status_idle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label" />

            <TextView
                android:id="@+id/testStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textSize="@dimen/text_hint"
                android:visibility="gone"
                tools:ignore="SmallSp" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTest"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:background="@drawable/bg_button_secondary"
                    android:contentDescription="@string/test_connection"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/test_connection_short"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_button" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_button"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:stateListAnimator="@null"
                    android:text="@string/connect"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnClearSession"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_danger"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/clear_session"
                android:textAllCaps="false"
                android:textColor="@color/error"
                android:textSize="@dimen/text_hint"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/settingsVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_hint"
                tools:text="Version 2.0.0 (6)" />
        </com.flux.codebuddy.ui.MaxWidthLinearLayout>
    </FrameLayout>
</ScrollView>
