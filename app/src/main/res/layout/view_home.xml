<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Home app bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/appbar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_logo"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_terminal"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="@dimen/text_title" />

            <ImageButton
                android:id="@+id/btnHomeSettings"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_settings"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- ===== Server card ===== -->
            <com.flux.codebuddy.ui.MaxWidthLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding"
                app:maxWidthDp="@dimen/content_max_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/homeStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_dot"
                        android:backgroundTint="@color/text_tertiary" />

                    <TextView
                        android:id="@+id/homeStatusLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/toolbar_status_idle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_hint" />

                    <TextView
                        android:id="@+id/homeServerChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_hint"
                        android:visibility="gone"
                        tools:text="192.168.1.100:7890"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/homeServerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/home_no_server"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_hint" />

                <TextView
                    android:id="@+id/homeServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_flat"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_hint"
                    android:visibility="gone"
                    tools:text="http://192.168.1.100:7890"
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btnHomePrimary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/home_open_chat"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/homeQuickRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnHomeNewChat"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/home_new_chat"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_button" />

                    <Button
                        android:id="@+id/btnHomeTest"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/home_test"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_button" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeServerActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <Button
                        android:id="@+id/btnHomeCopy"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_ghost"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/home_copy_url"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_hint" />

                    <Button
                        android:id="@+id/btnHomeBrowser"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_ghost"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/home_open_browser"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_hint" />
                </LinearLayout>
            </com.flux.codebuddy.ui.MaxWidthLinearLayout>

            <!-- ===== Recents ===== -->
            <LinearLayout
                android:id="@+id/recentsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/home_recents"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_label" />

                <Button
                    android:id="@+id/btnClearRecents"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_button_ghost"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:stateListAnimator="@null"
                    android:text="@string/home_recents_clear"
                    android:textAllCaps="false"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_hint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recentsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/recentsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card_flat"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="@string/home_recents_empty"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_hint" />

            <TextView
                android:id="@+id/homeVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_hint"
                tools:text="Version 2.0.0 (6) · arm64-v8a" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
